  "solidity": "pragma solidity >=0.8.0;\n\ncontract ConcatProbe {\n    string public s;\n    bytes public b;\n\n    function setConcat(string memory a, string memory c) public returns (string memory) {\n        s = string.concat(a, c);\n        return s;\n    }\n\n    function setBytesConcat(bytes memory x, bytes memory y) public returns (uint256) {\n        b = bytes.concat(x, y);\n        return b.length;\n    }\n}",
