  "solidity": "pragma solidity >=0.8.0;\n\ncontract IntDivOverflowWidths {\n    uint256 public count;\n    int128 public m128 = type(int128).min % int128(-1);\n    int64 public last;\n\n    function divWide(int64 x, int64 y) external returns (int64) {\n        int64 r = x / y;\n        count += 1;\n        last = r;\n        return r;\n    }\n\n    function bump() external {\n        count += 1;\n    }\n}",
