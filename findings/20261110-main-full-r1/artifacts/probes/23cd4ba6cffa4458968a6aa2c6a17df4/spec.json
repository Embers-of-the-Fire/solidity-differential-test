  "solidity": "pragma solidity >=0.8.0;\ncontract Sar256Mask {\n    int256 public last;\n    uint256 public count;\n    event Did(int256 r, uint256 n);\n    function sar256(int256 x, uint256 n) public returns (int256) {\n        int256 r = x >> n;\n        last = r;\n        count += 1;\n        emit Did(r, n);\n        return r;\n    }\n    function getLast() public view returns (int256) {\n        return last;\n    }\n    function getCount() public view returns (uint256) {\n        return count;\n    }\n}",
